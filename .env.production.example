# Copiar como .env.production solamente en el servidor.
# Este archivo es una plantilla: nunca colocar secretos reales en Git.
APP_ENV=production
APP_NAME=Belsitec Leads API
FRONTEND_ORIGINS=["https://iepmedalla.com","https://www.iepmedalla.com", "https://belsitec.com", "https://www.belsitec.com", "https://miedu.pe", "https://www.miedu.pe"]
ALLOWED_HOSTS=["srv475849.hstgr.cloud","217.196.61.5","api.iepmedalla.com","127.0.0.1","localhost"]
DOCS_ENABLED=false

DB_HOST=srv775.hstgr.io
DB_PORT=3306
DB_NAME=u411722909_iepmedalla
DB_USER=REEMPLAZAR_USUARIO_MYSQL
DB_PASSWORD=REEMPLAZAR_PASSWORD_MYSQL
DB_USE_TLS=true
# Ruta al CA del proveedor MySQL si no utiliza una CA publica del sistema.
# DB_SSL_CA=/etc/pki/tls/certs/mysql-provider-ca.pem
DB_PRODUCTION_HOST=srv775.hstgr.io
DB_PRODUCTION_NAME=u411722909_iepmedalla
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE=300

# Interruptor global para el envio de notificaciones de todas las marcas.
MAIL_ENABLED=true

# Perfiles SMTP por marca. Cada perfil debe tener todas sus variables antes de
# seleccionarlo como email_profile en app/config/brands.json. La activacion,
# los destinatarios y Reply-To de cada marca se configuran en ese archivo.
# "medalla" -> MEDALLA_MAIL_*, "belsitec" -> BELSITEC_MAIL_*,
# "miedu" -> MIEDU_MAIL_*. No hay fallback a MAIL_*.
MEDALLA_MAIL_HOST=smtp.gmail.com
MEDALLA_MAIL_PORT=587
MEDALLA_MAIL_USERNAME=info@iepmedalla.com
MEDALLA_MAIL_PASSWORD=REEMPLAZAR_PASSWORD_DE_APLICACION_GOOGLE
MEDALLA_MAIL_FROM=info@iepmedalla.com
MEDALLA_MAIL_FROM_NAME=I.E.P. Medalla
MEDALLA_MAIL_USE_TLS=true
MEDALLA_MAIL_TIMEOUT_SECONDS=10

BELSITEC_MAIL_HOST=smtp.gmail.com
BELSITEC_MAIL_PORT=587
BELSITEC_MAIL_USERNAME=REEMPLAZAR_USUARIO
BELSITEC_MAIL_PASSWORD=REEMPLAZAR_PASSWORD_DE_APLICACION
BELSITEC_MAIL_FROM=REEMPLAZAR_REMITENTE
BELSITEC_MAIL_FROM_NAME=Belsitec
BELSITEC_MAIL_USE_TLS=true
BELSITEC_MAIL_TIMEOUT_SECONDS=10

# Titan Email: STARTTLS sobre 587. El usuario es el correo completo. Usar la
# clave del buzon o una clave de aplicacion si la cuenta tiene 2FA.
MIEDU_MAIL_HOST=smtp.titan.email
MIEDU_MAIL_PORT=587
MIEDU_MAIL_USERNAME=contacto@miedu.pe
MIEDU_MAIL_PASSWORD=REEMPLAZAR_PASSWORD_BUZON_O_APLICACION_TITAN
MIEDU_MAIL_FROM=contacto@miedu.pe
MIEDU_MAIL_FROM_NAME=miedu.pe
MIEDU_MAIL_USE_TLS=true
MIEDU_MAIL_TIMEOUT_SECONDS=10

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=16384
BRAND_REGISTRY_PATH=app/config/brands.json
